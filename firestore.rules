rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'Y63ZCswFUsZbdBtbi1O4RLRV3ii2' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    function allowNewSignups() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowNewSignups', true) != false;
    }

    function allowVideoCalls() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowVideoCalls', true) != false;
    }

    function isAcceptedContact(chatId) {
      return exists(/databases/$(database)/documents/contactRequests/$(chatId)) &&
        get(/databases/$(database)/documents/contactRequests/$(chatId)).data.status == 'accepted';
    }

    match /config/appState {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && allowNewSignups()
        && username.matches('^[a-z0-9_]{1,12}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && allowNewSignups()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{1,12}$')
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('badge', '') == '';
      allow update: if (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
        && request.resource.data.get('badge', '') == resource.data.get('badge', '')
      ) || (
        isOwnerAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanned', 'badge', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /contactRequests/{pairId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.fromUid == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && (
          (request.auth.uid == resource.data.toUid && request.resource.data.status in ['accepted', 'declined']) ||
          (request.auth.uid == resource.data.fromUid && request.resource.data.status == 'pending')
        );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && isAcceptedContact(chatId);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && isAcceptedContact(chatId);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isAcceptedContact(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && (request.resource.data.type != 'call_invite' || allowVideoCalls());
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isAcceptedContact(chatId);
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.members || isOwnerAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members || isOwnerAdmin());
      allow create: if isSignedIn()
        && isNotBanned()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && (
          // Leaving group
          !(request.auth.uid in request.resource.data.members)
          ||
          // Regular group/family update respecting admin permissions
          (
            (!resource.data.permissions.onlyAdminsEditInfo || request.auth.uid in resource.data.admins || (request.resource.data.name == resource.data.name && request.resource.data.permissions == resource.data.permissions))
            &&
            (!resource.data.permissions.onlyAdminsAddMembers || request.auth.uid in resource.data.admins || request.resource.data.members == resource.data.members)
            &&
            (request.resource.data.permissions == resource.data.permissions || request.auth.uid in resource.data.admins)
            &&
            (request.resource.data.admins == resource.data.admins || request.auth.uid in resource.data.admins)
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && (request.resource.data.type != 'call_invite' || allowVideoCalls())
          && (
            !get(/databases/$(database)/documents/groups/$(groupId)).data.permissions.onlyAdminsSendMessages
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
          );
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if false;
      }
    }

    match /admins/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }
  }
}
