rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'Y63ZCswFUsZbdBtbi1O4RLRV3ii2' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['owner', 'admin', 'superadmin'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('usernameLower', '') == 'anlossagroup' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') in ['anlossagroup', '@anlossagroup']
          )
        )
      );
    }

    function isOwnerAdmin() {
      return isAdmin();
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    function allowNewSignups() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowNewSignups', true) != false;
    }

    function guestLoginEnabled() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('guestLoginEnabled', true) != false;
    }

    function isAnonymousAuth() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function allowVideoCalls() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowVideoCalls', true) != false;
    }

    function isGlobalMessagingLocked() {
      return exists(/databases/$(database)/documents/config/appState) &&
        get(/databases/$(database)/documents/config/appState).data.get('adminOnlyMessaging', false) == true;
    }

    function isAcceptedPair(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/contacts/$(uidB)) ||
        exists(/databases/$(database)/documents/users/$(uidB)/contacts/$(uidA));
    }

    function isValidMessagePayload() {
      return (
          request.resource.data.get('senderId', '') == request.auth.uid ||
          request.resource.data.get('senderUid', '') == request.auth.uid
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (
          request.resource.data.type != 'call_invite'
          || (
            allowVideoCalls()
            && request.resource.data.call.roomUrl is string
            && request.resource.data.call.roomUrl.matches('^https://meet\\.jit\\.si/voliud-[0-9]+$')
          )
        );
    }

    match /config/appState {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (isAnonymousAuth() ? (guestLoginEnabled() && username.matches('^guest_[a-z0-9]{5}$')) : allowNewSignups())
        && username.matches('^[a-z0-9_]{3,12}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && (isAnonymousAuth() || resource.data.get('isGuest', false) == true)
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (isAnonymousAuth() ? guestLoginEnabled() : allowNewSignups())
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isOwner', false) == false
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('badge', '') == ''
        && (
          !isAnonymousAuth()
          || (
            request.resource.data.get('isGuest', false) == true
            && request.resource.data.get('usernameLower', '').matches('^guest_[a-z0-9]{5}$')
          )
        )
        && (
          !('usernameLower' in request.resource.data)
          || request.resource.data.usernameLower == ''
          || request.resource.data.usernameLower.matches('^[a-z0-9_]{3,12}$')
        );
      allow update: if (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          !('usernameLower' in resource.data)
          || resource.data.usernameLower == ''
          || request.resource.data.usernameLower == resource.data.usernameLower
        )
        && (
          !('usernameLower' in request.resource.data)
          || request.resource.data.usernameLower == ''
          || request.resource.data.usernameLower.matches('^[a-z0-9_]{3,12}$')
        )
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('isOwner', false) == resource.data.get('isOwner', false)
        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
        && request.resource.data.get('badge', '') == resource.data.get('badge', '')
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isAdmin', 'isOwner', 'isBanned', 'badge', 'updatedAt'])
      );
      allow delete: if (isAdmin() && userId != request.auth.uid)
        || (
          isSignedIn()
          && request.auth.uid == userId
          && (isAnonymousAuth() || resource.data.get('isGuest', false) == true)
        );

      match /contacts/{contactUid} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == contactUid);
        allow write: if isSignedIn() && isNotBanned() && (request.auth.uid == userId || request.auth.uid == contactUid);
      }
    }

    match /contactRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.from == request.auth.uid
        || resource.data.to == request.auth.uid
      );
      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.status == 'pending'
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.to == request.auth.uid && request.resource.data.status in ['accepted', 'declined'])
        || (resource.data.from == request.auth.uid && request.resource.data.status == 'pending')
      );
      allow delete: if isSignedIn() && (
        resource.data.from == request.auth.uid
        || resource.data.to == request.auth.uid
      );
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && resource.data.participants.size() == 2
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && isNotBanned()
          && (!isGlobalMessagingLocked() || isAdmin())
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isValidMessagePayload();
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if isSignedIn()
          && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('senderUid', '') == request.auth.uid ||
            isAdmin()
          );
      }
    }

    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.members || isOwnerAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members || isOwnerAdmin());
      allow create: if isSignedIn()
        && isNotBanned()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins;
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            request.auth.uid in resource.data.members
            && (
              !(request.auth.uid in request.resource.data.members)
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedAt'])
              || (
                (!resource.data.permissions.onlyAdminsEditInfo || request.auth.uid in resource.data.admins || (request.resource.data.name == resource.data.name && request.resource.data.permissions == resource.data.permissions))
                &&
                (!resource.data.permissions.onlyAdminsAddMembers || request.auth.uid in resource.data.admins || request.resource.data.members == resource.data.members)
                &&
                (request.resource.data.permissions == resource.data.permissions || request.auth.uid in resource.data.admins)
                &&
                (request.resource.data.get('adminOnly', false) == resource.data.get('adminOnly', false) || request.auth.uid in resource.data.admins)
                &&
                (request.resource.data.admins == resource.data.admins || request.auth.uid in resource.data.admins)
              )
            )
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && isNotBanned()
          && (!isGlobalMessagingLocked() || isAdmin())
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && isValidMessagePayload()
          && (
            (
              !get(/databases/$(database)/documents/groups/$(groupId)).data.permissions.get('onlyAdminsSendMessages', false)
              && get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminOnly', false) != true
            )
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
            || isAdmin()
          );
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if isSignedIn()
          && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('senderUid', '') == request.auth.uid ||
            isAdmin()
          );
      }
    }

    match /adminLogs/{logId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn()
        && isNotBanned()
        && (
          request.resource.data.get('reporterId', '') == request.auth.uid ||
          request.resource.data.get('reporterUid', '') == request.auth.uid
        );
    }

    match /admins/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }
  }
}
