rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          )
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    function allowNewSignups() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowNewSignups', true) != false;
    }

    function allowVideoCalls() {
      return !exists(/databases/$(database)/documents/config/appState) ||
        get(/databases/$(database)/documents/config/appState).data.get('allowVideoCalls', true) != false;
    }

    function isAcceptedContact(chatId) {
      return exists(/databases/$(database)/documents/contactRequests/$(chatId)) &&
        get(/databases/$(database)/documents/contactRequests/$(chatId)).data.status == 'accepted';
    }

    function isAcceptedPair(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/contacts/$(uidB)) ||
        exists(/databases/$(database)/documents/users/$(uidB)/contacts/$(uidA));
    }

    function isValidMessagePayload() {
      return request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (
          request.resource.data.type != 'call_invite'
          || (
            allowVideoCalls()
            && request.resource.data.call.roomUrl is string
            && request.resource.data.call.roomUrl.matches('^https://meet\\.jit\\.si/voliud-[0-9]+$')
          )
        );
    }

    match /config/appState {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && allowNewSignups()
        && username.matches('^[a-z0-9_]{3,12}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && allowNewSignups()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('badge', '') == ''
        && (
          !('usernameLower' in request.resource.data)
          || request.resource.data.usernameLower == ''
          || request.resource.data.usernameLower.matches('^[a-z0-9_]{3,12}$')
        );
      allow update: if (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          !('usernameLower' in resource.data)
          || resource.data.usernameLower == ''
          || request.resource.data.usernameLower == resource.data.usernameLower
        )
        && (
          !('usernameLower' in request.resource.data)
          || request.resource.data.usernameLower == ''
          || request.resource.data.usernameLower.matches('^[a-z0-9_]{3,12}$')
        )
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
        && request.resource.data.get('badge', '') == resource.data.get('badge', '')
      ) || (
        isOwnerAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isAdmin', 'isBanned', 'badge', 'updatedAt'])
      );
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == contactUid);
        allow write: if isSignedIn() && isNotBanned() && (request.auth.uid == userId || request.auth.uid == contactUid);
      }
    }

    match /contactRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource == null
        || request.auth.uid == resource.data.get('from', '')
        || request.auth.uid == resource.data.get('to', '')
        || request.auth.uid in resource.data.get('participants', [])
      );
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.get('from', '')
        || request.auth.uid == resource.data.get('to', '')
        || request.auth.uid in resource.data.get('participants', [])
      );
      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.status == 'pending'
        && (
          (
            request.resource.data.from == request.auth.uid
            && request.resource.data.to is string
            && request.resource.data.to != request.auth.uid
          )
          || (
            request.resource.data.fromUid == request.auth.uid
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == 2
          )
        );
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.get('to', '') && request.resource.data.status in ['accepted', 'declined'])
        || (request.auth.uid == resource.data.get('from', '') && request.resource.data.status == 'pending')
        || (
          request.auth.uid in resource.data.get('participants', [])
          && (
            (request.auth.uid == resource.data.get('toUid', '') && request.resource.data.status in ['accepted', 'declined'])
            || (request.auth.uid == resource.data.get('fromUid', '') && request.resource.data.status == 'pending')
          )
        )
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('from', '')
        || request.auth.uid == resource.data.get('to', '')
        || request.auth.uid in resource.data.get('participants', [])
      );
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && (
          isAcceptedContact(chatId)
          || isAcceptedPair(request.resource.data.participants[0], request.resource.data.participants[1])
        );
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && (
          isAcceptedContact(chatId)
          || (
            resource.data.participants.size() == 2
            && isAcceptedPair(resource.data.participants[0], resource.data.participants[1])
          )
        );

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            isAcceptedContact(chatId)
            || isAcceptedPair(
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
            )
          )
          && isValidMessagePayload();
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            isAcceptedContact(chatId)
            || isAcceptedPair(
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
            )
          );
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.members || isOwnerAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members || isOwnerAdmin());
      allow create: if isSignedIn()
        && isNotBanned()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && (
          !(request.auth.uid in request.resource.data.members)
          || (
            (!resource.data.permissions.onlyAdminsEditInfo || request.auth.uid in resource.data.admins || (request.resource.data.name == resource.data.name && request.resource.data.permissions == resource.data.permissions))
            &&
            (!resource.data.permissions.onlyAdminsAddMembers || request.auth.uid in resource.data.admins || request.resource.data.members == resource.data.members)
            &&
            (request.resource.data.permissions == resource.data.permissions || request.auth.uid in resource.data.admins)
            &&
            (request.resource.data.admins == resource.data.admins || request.auth.uid in resource.data.admins)
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && isValidMessagePayload()
          && (
            !get(/databases/$(database)/documents/groups/$(groupId)).data.permissions.onlyAdminsSendMessages
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
          );
        allow update: if isSignedIn()
          && isNotBanned()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if false;
      }
    }

    match /adminLogs/{logId} {
      allow read, create: if isOwnerAdmin();
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read, update: if isOwnerAdmin();
      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.reporterUid == request.auth.uid;
      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }
  }
}
