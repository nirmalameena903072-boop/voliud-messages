{
  "rules": {
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === null || (newData.hasChildren(['username', 'updatedAt']) && newData.child('username').isString() && newData.child('updatedAt').isNumber())"
        }
      }
    }
  }
}
